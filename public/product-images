import { createClient } from "@supabase/supabase-js";
import { fetch } from "undici";
import sharp from "sharp";

const SUPABASE_URL = process.env.SUPABASE_URL;
const SUPABASE_SERVICE_ROLE_KEY = process.env.SUPABASE_SERVICE_ROLE_KEY;

if (!SUPABASE_URL || !SUPABASE_SERVICE_ROLE_KEY) {
  console.error("Missing env vars: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY");
  process.exit(1);
}

const supabase = createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, {
  auth: { persistSession: false },
});

const BUCKET = "product-images";

/**
 * BRAND-SPECIFIC CANDIDATE GENERATORS
 * These are “best-effort” heuristics based on your existing dataset patterns.
 * You can add more rules as you discover consistent manufacturer URL formats.
 */

// Makita UK often uses model code images, e.g. DGA452.jpg
function extractMakitaModelCode(product) {
  const text = `${product.name || ""} ${product.description || ""}`.toUpperCase();
  // Examples to catch: DGA452, DHP484, DTD152, etc.
  const m = text.match(/\b([A-Z]{2,4}\d{3,4})\b/);
  return m ? m[1] : null;
}

function makitaCandidates(product) {
  const model = extractMakitaModelCode(product);
  if (!model) return [];
  return [
    `https://www.makita.co.uk/images/product/${model}.jpg`,
    `https://www.makita.co.uk/images/product/${model}.JPG`,
  ];
}

/**
 * DeWalt / Bosch / Paslode vary and may block hotlinking.
 * The safest method is: use your own source list, or scrape product pages you control.
 * Until you have reliable patterns, we treat these as “manual seed required”:
 * - Put URLs in product_image_map.source_url for those SKUs
 * - Script will use source_url if present.
 */

function genericCandidatesFromSourceUrl(product, mapRow) {
  const src = (mapRow?.source_url || "").trim();
  return src ? [src] : [];
}

function getBrandNameLookup(brands) {
  const byId = new Map();
  for (const b of brands) byId.set(b.id, (b.name || "").toLowerCase());
  return byId;
}

async function headOk(url) {
  try {
    const res = await fetch(url, { method: "HEAD" });
    return res.status >= 200 && res.status < 300;
  } catch {
    return false;
  }
}

async function downloadImage(url) {
  const res = await fetch(url);
  if (!res.ok) throw new Error(`Download failed: ${res.status} ${url}`);
  const buf = Buffer.from(await res.arrayBuffer());
  return buf;
}

async function normaliseToJpeg(buffer) {
  // Consistent format, consistent size, avoids weird PNG transparency artefacts on dark theme
  return sharp(buffer)
    .resize(900, 900, { fit: "inside", withoutEnlargement: true })
    .jpeg({ quality: 85 })
    .toBuffer();
}

async function uploadToStorage(path, buffer) {
  const { error } = await supabase.storage.from(BUCKET).upload(path, buffer, {
    upsert: true,
    contentType: "image/jpeg",
    cacheControl: "3600",
  });
  if (error) throw error;

  const { data } = supabase.storage.from(BUCKET).getPublicUrl(path);
  return data.publicUrl;
}

async function upsertMap(sku, fields) {
  const payload = { sku, ...fields };
  const { error } = await supabase
    .from("product_image_map")
    .upsert(payload, { onConflict: "sku" });
  if (error) throw error;
}

async function run() {
  // Pull brands (for name lookup)
  const { data: brands, error: brandErr } = await supabase
    .from("brands")
    .select("id,name");

  if (brandErr) throw brandErr;
  const brandById = getBrandNameLookup(brands || []);

  // Pull candidate products missing images
  // You can restrict to top brands by name match here.
  const { data: products, error: prodErr } = await supabase
    .from("products")
    .select("id,sku,name,description,brand_id,is_active,image_url")
    .eq("is_active", true)
    .or("image_url.is.null,image_url.eq.") // null or empty string
    .limit(5000);

  if (prodErr) throw prodErr;

  // Pull existing map rows (source_url may be populated for some)
  const { data: maps, error: mapErr } = await supabase
    .from("product_image_map")
    .select("sku,source_url,image_url,status");

  if (mapErr) throw mapErr;

  const mapBySku = new Map((maps || []).map((m) => [m.sku?.toLowerCase(), m]));

  let processed = 0;
  let success = 0;
  let failed = 0;

  for (const p of products || []) {
    const sku = (p.sku || "").trim();
    if (!sku) continue;

    const brandName = brandById.get(p.brand_id) || "";
    const mapRow = mapBySku.get(sku.toLowerCase());

    // Skip if already mapped with an image_url
    if (mapRow?.image_url && mapRow.image_url.trim().length > 0) continue;

    let candidates = [];

    // 1) If you manually seeded source_url in the map table, prefer it
    candidates.push(...genericCandidatesFromSourceUrl(p, mapRow));

    // 2) Apply brand-specific heuristics
    if (brandName.includes("makita")) {
      candidates.push(...makitaCandidates(p));
    }

    // Add future rules here for DeWalt/Bosch/Paslode once you confirm stable URL formats

    // Deduplicate
    candidates = [...new Set(candidates.filter(Boolean))];

    processed++;

    if (candidates.length === 0) {
      await upsertMap(sku, {
        status: "no_candidate",
        last_checked_at: new Date().toISOString(),
        notes: "No candidate URL rules matched. Add source_url manually or extend rules.",
      });
      continue;
    }

    // Find first candidate that passes HEAD
    let chosen = null;
    for (const c of candidates) {
      if (await headOk(c)) {
        chosen = c;
        break;
      }
    }

    if (!chosen) {
      failed++;
      await upsertMap(sku, {
        source_url: candidates[0],
        status: "unreachable",
        last_checked_at: new Date().toISOString(),
        notes: `All candidates failed HEAD check (${candidates.length}). Likely blocked/hotlink/404.`,
      });
      continue;
    }

    try {
      const raw = await downloadImage(chosen);
      const jpeg = await normaliseToJpeg(raw);

      const safeBrand = (brandName || "unknown").replace(/[^a-z0-9]+/gi, "-").toLowerCase();
      const storagePath = `${safeBrand}/${sku}.jpg`;

      const publicUrl = await uploadToStorage(storagePath, jpeg);

      await upsertMap(sku, {
        source_url: chosen,
        image_url: publicUrl,
        status: "ok",
        last_checked_at: new Date().toISOString(),
        notes: `Uploaded to ${storagePath}`,
      });

      success++;
      if (success % 50 === 0) {
        console.log(`Progress: processed=${processed} success=${success} failed=${failed}`);
      }
    } catch (e) {
      failed++;
      await upsertMap(sku, {
        source_url: chosen,
        status: "error",
        last_checked_at: new Date().toISOString(),
        notes: `Ingestion error: ${e.message}`,
      });
    }
  }

  console.log(`DONE: processed=${processed} success=${success} failed=${failed}`);
}

run().catch((e) => {
  console.error(e);
  process.exit(1);
});


